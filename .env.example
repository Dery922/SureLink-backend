MONGO_URI=mongodb://127.0.0.1:27017/surelink
REDIS_URL=redis://127.0.0.1:6379
# Generate a strong random value and set it in your local `.env` (do not commit).
SESSION_SECRET=
PORT=5000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed origins (overrides FRONTEND_URL when set)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development

# ── Admin seed credentials (used by: npm run seed:admins) ──────────────────
# If not set, the seed script uses the fallback dev values printed in its output.
SEED_SUPER_ADMIN_EMAIL=superadmin@surelink.dev
SEED_SUPER_ADMIN_PASSWORD=
SEED_PROVIDER_ADMIN_EMAIL=provideradmin@surelink.dev
SEED_PROVIDER_ADMIN_PASSWORD=
SEED_OPERATIONS_ADMIN_EMAIL=opsadmin@surelink.dev
SEED_OPERATIONS_ADMIN_PASSWORD=

# ── Transactional email (Brevo) — used to deliver OTP codes over email ─────
# Delivery is best-effort: if BREVO_API_KEY is unset, email sends are skipped
# and the dev `otp_preview` in the API response is the fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=franklindery922@gmail.com
BREVO_SENDER_NAME=SureLink

